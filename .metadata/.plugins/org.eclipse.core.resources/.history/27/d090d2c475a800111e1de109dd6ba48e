package it.unipv.ingsfw.Uploop.model;

import javax.swing.JFrame;
import javax.swing.JOptionPane;

public class RegistrationController {
    
    // Il controller ora riceve tutti i dati dalla View e si occupa della logica
    public void gestisciRegistrazione(String user, String email, String pass, String confPass, JFrame finestraRegistrazione) {
        
        if (user.isEmpty() || email.isEmpty() || pass.isEmpty() || confPass.isEmpty()) {
            JOptionPane.showMessageDialog(finestraRegistrazione, "Compila tutti i campi!", "Errore", JOptionPane.ERROR_MESSAGE);
            return;
        }

        if (!email.contains("@") || !email.contains(".")) {
            JOptionPane.showMessageDialog(finestraRegistrazione, "Inserisci un indirizzo email valido.", "Errore Email", JOptionPane.WARNING_MESSAGE);
            return;
        }

        if (!pass.equals(confPass)) {
            JOptionPane.showMessageDialog(finestraRegistrazione, "Le password non coincidono! Riprova.", "Errore Password", JOptionPane.WARNING_MESSAGE);
            return;
        }

        // Il Controller interroga il Model
        boolean successo = SessionManager.getInstance().registra(user, pass);
        
        // Il Controller aggiorna la View
        if (successo) {
            JOptionPane.showMessageDialog(finestraRegistrazione, "Account creato con successo!\nOra puoi effettuare l'accesso.", "Benvenuto!", JOptionPane.PLAIN_MESSAGE);
            new LoginFrame();
            finestraRegistrazione.dispose(); 
        } else {
            JOptionPane.showMessageDialog(finestraRegistrazione, "L'username '" + user + "' è già in uso. Scegline un altro.", "Errore", JOptionPane.ERROR_MESSAGE);
        }
    }
}
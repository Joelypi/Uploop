package it.unipv.ingsfw.Uploop.model;

import it.unipv.ingsfw.Uploop.dao.MySqlUserDAO;
import it.unipv.ingsfw.Uploop.dao.UserDAO;
import it.unipv.ingsfw.Uploop.model.User;

public class SessionManager {
    private static SessionManager instance;
    private User currentUser;
    
    // Connessione al VERO database MySQL!
    private UserDAO userDAO = new MySqlUserDAO(); 

    private SessionManager() {
    }

    public static SessionManager getInstance() {
        if (instance == null) {
            instance = new SessionManager();
        }
        return instance;
    }

    // Metodo per il Login
    public boolean login(String username, String password) {
        User user = userDAO.findByUsername(username);
        
        if (user != null && user.getPassword().equals(password)) {
            currentUser = user;
            return true;
        }
        return false;
    }

    // Metodo per il Logout
    public void logout() {
        currentUser = null;
    }

    public User getCurrentUser() {
        return currentUser;
    }
    
    // --- METODI RIPRISTINATI PER RIMUOVERE GLI ERRORI ROSSI ---
    
    // 1. Ripristinato per far funzionare RegistrationController
    public boolean registra(String username, String password) {
        // Controlla se l'utente esiste già nel vero database
        if (userDAO.findByUsername(username) != null) {
            return false; // Ritorna falso se il nome è già preso
        }
        
        // Se non esiste, crea l'utente e lo salva in MySQL
        User newUser = new User(username, password);
        userDAO.save(newUser);
        return true; // Ritorna vero per confermare la registrazione
    }
    
    // 2. Ripristinato per far funzionare OrderFrame
    public void salvaDati() {
        // Con MySQL il salvataggio è immediato, quindi qui non dobbiamo fare più nulla!
        // Ma lasciamo il metodo vuoto così OrderFrame non va in crash.
        System.out.println("Salvataggio automatico completato.");
    }
}
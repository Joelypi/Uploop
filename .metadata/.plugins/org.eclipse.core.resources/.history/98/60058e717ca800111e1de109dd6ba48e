package it.unipv.ingsfw.Uploop.model;

import java.io.Serializable;

public class Order implements Serializable {
    private String formato;
    private int quantita;
    private String carta;
    private double prezzoTotale;
    private String stato;

    public Order(String formato, int quantita, String carta, double prezzoTotale) {
        this.formato = formato;
        this.quantita = quantita;
        this.carta = carta;
        this.prezzoTotale = prezzoTotale;
        this.stato = "In Lavorazione";
    }

    public String getFormato() { return formato; }
    public int getQuantita() { return quantita; }
    public String getCarta() { return carta; }
    public double getPrezzoTotale() { return prezzoTotale; }
    public String getStato() { return stato; }
}

    private void impostaStileBiancoENero(JComponent campo, Font font, Dimension size) {
        campo.setFont(font); campo.setBackground(Color.WHITE); campo.setForeground(Color.BLACK);
        campo.setOpaque(true); campo.setPreferredSize(size); campo.setMinimumSize(size);
        campo.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(Color.BLACK, 2), BorderFactory.createEmptyBorder(6, 6, 6, 6)
        )); 
        if (campo instanceof JComboBox) {
            JComboBox<?> combo = (JComboBox<?>) campo;
            combo.setRenderer(new DefaultListCellRenderer() {
                public Component getListCellRendererComponent(JList<?> list, Object value, int index, boolean isSelected, boolean cellHasFocus) {
                    JLabel label = (JLabel) super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);
                    label.setBackground(isSelected ? new Color(220, 220, 220) : Color.WHITE);
                    label.setForeground(Color.BLACK); label.setOpaque(true); return label;
                }
            });
            combo.setUI(new BasicComboBoxUI() {
                public void paint(Graphics g, JComponent c) {
                    g.setColor(Color.WHITE); g.fillRect(0, 0, c.getWidth(), c.getHeight()); super.paint(g, c);
                }
                protected JButton createArrowButton() {
                    JButton btn = new JButton("▼"); btn.setFont(new Font("Segoe UI", Font.BOLD, 12));
                    btn.setBackground(Color.WHITE); btn.setForeground(Color.BLACK);
                    btn.setBorder(BorderFactory.createEmptyBorder(0, 5, 0, 5));
                    btn.setContentAreaFilled(false); btn.setOpaque(true); btn.setCursor(new Cursor(Cursor.HAND_CURSOR));
                    return btn;
                }
            });
        }
    }

    private void elaboraOrdine() {
        User utenteCorrente = SessionManager.getInstance().getCurrentUser();
        if (utenteCorrente == null) {
            JOptionPane.showMessageDialog(this, "Devi effettuare l'accesso o registrarti per poter completare l'ordine!", "Accesso Richiesto", JOptionPane.WARNING_MESSAGE);
            return;
        }

        String formato = (String) comboFormato.getSelectedItem();
        String quantitaTesto = txtQuantita.getText().trim();
        String carta = (String) comboCarta.getSelectedItem();
        String idea = txtNote.getText().trim();
        
        if (formato == null || formato.equals("- Seleziona Formato -") || quantitaTesto.isEmpty() || carta == null || carta.equals("- Seleziona Carta -") || idea.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Compila tutti i campi prima di procedere!", "Attenzione", JOptionPane.ERROR_MESSAGE);
            return;
        }
        
        int quantita = Integer.parseInt(quantitaTesto);
        if (quantita <= 0) {
            JOptionPane.showMessageDialog(this, "La quantità deve essere maggiore di zero.", "Attenzione", JOptionPane.ERROR_MESSAGE);
            return;
        }
        
        double costoBase = quantita * 0.50; 
        if (chkGraficaVettoriale.isSelected()) costoBase += 20.00; 

        // Passiamo vettoriale e idea al metodo successivo invece di salvare qui
        mostraFinestraPagamento(costoBase, formato, quantita, carta, chkGraficaVettoriale.isSelected(), idea);
    }
    
    private void mostraFinestraPagamento(double totale, String formato, int quantita, String carta, boolean vettoriale, String idea) {
        JDialog paymentDialog = new JDialog(this, "Pagamento Sicuro", true);
        paymentDialog.setSize(450, 550);
        paymentDialog.setLocationRelativeTo(this);
        paymentDialog.setLayout(new BorderLayout());

        JPanel mainPanel = new JPanel();
        mainPanel.setLayout(new BoxLayout(mainPanel, BoxLayout.Y_AXIS));
        mainPanel.setBorder(new EmptyBorder(30, 40, 30, 40)); 
        mainPanel.setBackground(Color.WHITE);
        
        JLabel lblTitolo = new JLabel("Pagamento Sicuro");
        lblTitolo.setFont(new Font("Segoe UI", Font.BOLD, 26));
        lblTitolo.setAlignmentX(Component.CENTER_ALIGNMENT);
        mainPanel.add(lblTitolo);
        
        JLabel lblSottotitolo = new JLabel("Totale da pagare: €" + String.format("%.2f", totale));
        lblSottotitolo.setFont(new Font("Segoe UI", Font.PLAIN, 16));
        lblSottotitolo.setForeground(Color.DARK_GRAY);
        lblSottotitolo.setAlignmentX(Component.CENTER_ALIGNMENT);
        mainPanel.add(lblSottotitolo);
        mainPanel.add(Box.createRigidArea(new Dimension(0, 30)));

        JPanel formPanel = new JPanel(new GridBagLayout());
        formPanel.setBackground(Color.WHITE);
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.anchor = GridBagConstraints.WEST;
        gbc.weightx = 1.0;

        Font labelFont = new Font("Segoe UI", Font.BOLD, 13);
        Color labelColor = new Color(100, 100, 100);

        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 2; gbc.insets = new Insets(0, 0, 5, 0);
        JLabel lblNome = new JLabel("Nome sulla carta");
        lblNome.setFont(labelFont); lblNome.setForeground(labelColor);
        formPanel.add(lblNome, gbc);
        
        gbc.gridy = 1; gbc.insets = new Insets(0, 0, 15, 0);
        JTextField txtNome = new JTextField(); impostaStilePagamento(txtNome);
        txtNome.addKeyListener(new KeyAdapter() {
            public void keyTyped(KeyEvent evt) {
                if (Character.isDigit(evt.getKeyChar())) evt.consume();
            }
        });
        formPanel.add(txtNome, gbc);

        gbc.gridy = 2; gbc.insets = new Insets(0, 0, 5, 0);
        JLabel lblNumero = new JLabel("Numero della Carta");
        lblNumero.setFont(labelFont); lblNumero.setForeground(labelColor);
        formPanel.add(lblNumero, gbc);
        
        gbc.gridy = 3; gbc.insets = new Insets(0, 0, 15, 0);
        JTextField txtNumero = new JTextField(); impostaStilePagamento(txtNumero);
        txtNumero.addKeyListener(new KeyAdapter() {
            public void keyTyped(KeyEvent evt) {
                if (!Character.isDigit(evt.getKeyChar()) || txtNumero.getText().length() >= 16) evt.consume();
            }
        });
        formPanel.add(txtNumero, gbc);

        gbc.gridy = 4; gbc.gridwidth = 1; gbc.gridx = 0; gbc.insets = new Insets(0, 0, 5, 10);
        JLabel lblScadenza = new JLabel("Scadenza (MMYY)");
        lblScadenza.setFont(labelFont); lblScadenza.setForeground(labelColor);
        formPanel.add(lblScadenza, gbc);

        gbc.gridy = 5; gbc.insets = new Insets(0, 0, 15, 10);
        JTextField txtScadenza = new JTextField(); impostaStilePagamento(txtScadenza);
        txtScadenza.addKeyListener(new KeyAdapter() {
            public void keyTyped(KeyEvent evt) {
                if (!Character.isDigit(evt.getKeyChar()) || txtScadenza.getText().length() >= 4) evt.consume();
            }
        });
        formPanel.add(txtScadenza, gbc);

        gbc.gridy = 4; gbc.gridx = 1; gbc.insets = new Insets(0, 0, 5, 0);
        JLabel lblCvv = new JLabel("CVV");
        lblCvv.setFont(labelFont); lblCvv.setForeground(labelColor);
        formPanel.add(lblCvv, gbc);

        gbc.gridy = 5; gbc.insets = new Insets(0, 0, 15, 0);
        JTextField txtCvv = new JTextField(); impostaStilePagamento(txtCvv);
        txtCvv.addKeyListener(new KeyAdapter() {
            public void keyTyped(KeyEvent evt) {
                if (!Character.isDigit(evt.getKeyChar()) || txtCvv.getText().length() >= 3) evt.consume();
            }
        });
        formPanel.add(txtCvv, gbc);

        mainPanel.add(formPanel);
        mainPanel.add(Box.createRigidArea(new Dimension(0, 20)));

        BWButton btnConfermaPagamento = new BWButton("PAGA ORA");
        btnConfermaPagamento.setAlignmentX(Component.CENTER_ALIGNMENT);
        
        btnConfermaPagamento.addActionListener(e -> {
            if (txtNome.getText().trim().isEmpty() || txtNumero.getText().trim().isEmpty() || txtScadenza.getText().trim().isEmpty() || txtCvv.getText().trim().isEmpty()) {
                JOptionPane.showMessageDialog(paymentDialog, "Compila tutti i dati della carta per procedere!", "Errore", JOptionPane.ERROR_MESSAGE);
                return;
            }

            // 🚨 CHIAMATA AL CONTROLLER MVC (Codice sistemato!)
            it.unipv.ingsfw.Uploop.controller.OrderController controller = new it.unipv.ingsfw.Uploop.controller.OrderController();
            controller.confermaOrdine(formato, quantita, carta, vettoriale, idea, totale, txtNumero.getText().trim(), paymentDialog, this);
        });
        
        mainPanel.add(btnConfermaPagamento); 
        mainPanel.add(Box.createVerticalGlue());
        
        paymentDialog.add(mainPanel, BorderLayout.CENTER);
        paymentDialog.setVisible(true);
    }
    
    private void impostaStilePagamento(JTextField campo) {
        campo.setFont(new Font("Segoe UI", Font.PLAIN, 15)); 
        campo.setBackground(new Color(250, 250, 250));
        campo.setForeground(Color.BLACK); 
        campo.setCaretColor(Color.BLACK); 
        campo.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(new Color(200, 200, 200), 1), 
            BorderFactory.createEmptyBorder(8, 12, 8, 12)
        ));
        campo.setPreferredSize(new Dimension(0, 40)); 
    }

    private class BWButton extends JButton {
        public BWButton(String text) {
            super(text); setForeground(Color.WHITE); setBackground(Color.BLACK); setFont(new Font("Segoe UI", Font.BOLD, 18));
            setContentAreaFilled(false); setFocusPainted(false); setBorderPainted(false); setCursor(new Cursor(Cursor.HAND_CURSOR));
            setPreferredSize(new Dimension(400, 50)); setMaximumSize(new Dimension(400, 50));
            addMouseListener(new java.awt.event.MouseAdapter() {
                public void mouseEntered(java.awt.event.MouseEvent evt) { setBackground(Color.WHITE); setForeground(Color.BLACK); }
                public void mouseExited(java.awt.event.MouseEvent evt) { setBackground(Color.BLACK); setForeground(Color.WHITE); }
            });
        }
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create(); g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(getBackground()); g2.fillRect(0, 0, getWidth(), getHeight()); 
            if (getBackground().equals(Color.WHITE)) { g2.setColor(Color.BLACK); g2.setStroke(new BasicStroke(3)); g2.drawRect(1, 1, getWidth()-2, getHeight()-2); }
            super.paintComponent(g); g2.dispose();
        }
    }

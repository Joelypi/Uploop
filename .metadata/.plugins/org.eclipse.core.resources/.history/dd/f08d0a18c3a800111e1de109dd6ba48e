package it.unipv.ingsfw.Uploop.controller;

import javax.swing.JFrame;
import javax.swing.JOptionPane;

import it.unipv.ingsfw.Uploop.frame.OrderFrame;
import it.unipv.ingsfw.Uploop.model.SessionManager;

public class LoginController {

    public void gestisciLogin(String username, String password, JFrame finestraLogin) {
        // Controllo campi vuoti
        if (username.isEmpty() || password.isEmpty()) {
            JOptionPane.showMessageDialog(finestraLogin, "Inserisci Username e Password!", "Errore", JOptionPane.ERROR_MESSAGE);
            return;
        }

        // Invece di usare il finto DAO in memoria, interroghiamo il VERO database (SessionManager)
        boolean loggato = SessionManager.getInstance().login(username, password);

        if (loggato) {
            JOptionPane.showMessageDialog(finestraLogin, "Login effettuato con successo! Bentornato, " + username + "!");
            finestraLogin.dispose(); // Chiude la finestra di login
            
            // Qui apri la schermata principale dell'app (es. la Dashboard o l'Ordine)
            
            new DashboardFrame(); 
        } else {
            JOptionPane.showMessageDialog(finestraLogin, "Username o password errati!", "Errore Accesso", JOptionPane.ERROR_MESSAGE);
        }
    }
}
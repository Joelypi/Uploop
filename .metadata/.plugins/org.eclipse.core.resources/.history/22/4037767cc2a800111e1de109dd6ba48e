package it.unipv.ingsfw.Uploop.dao;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;
import it.unipv.ingsfw.Uploop.model.Order;

public class MySqlOrderDAO {
	
    // ATTENZIONE: Usa la stessa identica password di MySqlUserDAO!
    private final String URL = DBConfig.getProperty("db.url");
    private final String USER = DBConfig.getProperty("db.user");
    private final String PASSWORD = DBConfig.getProperty("db.password");

    // Questo è il metodo magico che prende i dati e li spara nel database
    public void salvaOrdine(String username, String formato, int quantita, String tipoCarta, boolean grafica, String note) {
        String query = "INSERT INTO orders (username, formato, quantita, tipo_carta, grafica_vettoriale, note) VALUES (?, ?, ?, ?, ?, ?)";
        
        try (Connection conn = DriverManager.getConnection(URL, USER, PASSWORD);
             PreparedStatement stmt = conn.prepareStatement(query)) {
            
            stmt.setString(1, username);
            stmt.setString(2, formato);
            stmt.setInt(3, quantita);
            stmt.setString(4, tipoCarta);
            stmt.setBoolean(5, grafica);
            stmt.setString(6, note);
            
            stmt.executeUpdate(); // Esegue l'inserimento!
            System.out.println("BINGO! Ordine salvato con successo nel database!");
            
        } catch (SQLException e) {
            System.out.println("Errore durante il salvataggio dell'ordine:");
            e.printStackTrace();
        }
    }

    // --- DA QUI INIZIA LA PARTE NUOVA AGGIUNTA ---
    // Questo metodo va nel database, prende gli ordini dell'utente e li restituisce a Java
    public List<Order> getOrdiniUtente(String username) {
        List<Order> listaOrdini = new ArrayList<>();
        String query = "SELECT * FROM orders WHERE username = ?";
        
        try (Connection conn = DriverManager.getConnection(URL, USER, PASSWORD);
             PreparedStatement stmt = conn.prepareStatement(query)) {
            
            stmt.setString(1, username);
            ResultSet rs = stmt.executeQuery();
            
            while (rs.next()) {
                String formato = rs.getString("formato");
                int quantita = rs.getInt("quantita");
                String carta = rs.getString("tipo_carta");
                
                // Ricalcoliamo il totale (0.50€ a copia + 20€ se c'è grafica vettoriale)
                double totale = quantita * 0.50;
                if (rs.getBoolean("grafica_vettoriale")) {
                    totale += 20.00;
                }
                
                Order ordine = new Order(formato, quantita, carta, totale);
                listaOrdini.add(ordine);
            }
            
        } catch (SQLException e) {
            System.out.println("Errore durante il recupero degli ordini:");
            e.printStackTrace();
        }
        
        return listaOrdini;
    }
    // --- FINE DELLA PARTE NUOVA AGGIUNTA ---
}
    // --- FINESTRA IMMAGINE SCHERMO INTERO ---
    private void mostraImmagineIngrandita(BufferedImage img) {
        JDialog zoomDialog = new JDialog(this, "Zoom Locandina", true);
        zoomDialog.setLayout(new BorderLayout());
        zoomDialog.getContentPane().setBackground(new Color(30, 30, 30)); 

        Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize();
        int maxWidth = (int) (screenSize.width * 0.85); 
        int maxHeight = (int) (screenSize.height * 0.85);

        int imgW = img.getWidth();
        int imgH = img.getHeight();

        if (imgW > maxWidth || imgH > maxHeight) {
            double scale = Math.min((double) maxWidth / imgW, (double) maxHeight / imgH);
            imgW = (int) (imgW * scale);
            imgH = (int) (imgH * scale);
        }

        Image imgIngrandita = img.getScaledInstance(imgW, imgH, Image.SCALE_SMOOTH);
        JLabel lblZoom = new JLabel(new ImageIcon(imgIngrandita));
        lblZoom.setHorizontalAlignment(SwingConstants.CENTER);
        
        lblZoom.setCursor(new Cursor(Cursor.HAND_CURSOR));
        lblZoom.setToolTipText("Clicca per chiudere");
        lblZoom.addMouseListener(new java.awt.event.MouseAdapter() {
            public void mouseClicked(java.awt.event.MouseEvent e) {
                zoomDialog.dispose();
            }
        });

        zoomDialog.add(lblZoom, BorderLayout.CENTER);
        
        JLabel lblIstruzione = new JLabel("Clicca sull'immagine per chiudere");
        lblIstruzione.setForeground(Color.LIGHT_GRAY);
        lblIstruzione.setHorizontalAlignment(SwingConstants.CENTER);
        lblIstruzione.setBorder(new EmptyBorder(10, 0, 10, 0));
        zoomDialog.add(lblIstruzione, BorderLayout.SOUTH);

        zoomDialog.setSize(imgW + 50, imgH + 80); 
        zoomDialog.setLocationRelativeTo(null); 
        zoomDialog.setVisible(true);
    }

    // --- CLASSE INTERNA PER I BOTTONI PARTICOLARI ---
    private class ModernButton extends JButton {
        private Color normalColor;
        private Color hoverColor;

        public ModernButton(String text, Color normalColor, Color hoverColor, Color textColor) {
            super(text);
            this.normalColor = normalColor;
            this.hoverColor = hoverColor;
            setForeground(textColor);
            setFont(new Font("Segoe UI", Font.BOLD, 14));
            setContentAreaFilled(false); 
            setFocusPainted(false);
            setBorderPainted(false);
            setCursor(new Cursor(Cursor.HAND_CURSOR));
            setAlignmentX(Component.RIGHT_ALIGNMENT); 
            setPreferredSize(new Dimension(250, 50));
            setMaximumSize(new Dimension(250, 50));

            addMouseListener(new java.awt.event.MouseAdapter() {
                public void mouseEntered(java.awt.event.MouseEvent evt) {
                    setBackground(hoverColor);
                }
                public void mouseExited(java.awt.event.MouseEvent evt) {
                    setBackground(normalColor);
                }
            });
        }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            
            if (getModel().isRollover()) {
                g2.setColor(hoverColor);
            } else {
                g2.setColor(normalColor);
            }
            
            g2.fillRoundRect(0, 0, getWidth(), getHeight(), 30, 30);
            
            super.paintComponent(g);
            g2.dispose();
        }
    }

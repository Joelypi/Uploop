package it.unipv.ingsfw.Uploop.model;

import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.util.ArrayList;
import java.util.List;

public class SessionManager {
    private static SessionManager instance;
    private User currentUser;
    private List<User> utentiRegistrati;

    private SessionManager() {
        utentiRegistrati = new ArrayList<>();
        caricaDati(); 
    }

    public static SessionManager getInstance() {
        if (instance == null) {
            instance = new SessionManager();
        }
        return instance;
    }

    public User getCurrentUser() {
        return currentUser;
    }

    public boolean login(String username, String password) {
        for (User u : utentiRegistrati) {
            if (u.getUsername().equals(username) && u.getPassword().equals(password)) {
                currentUser = u;
                salvaDati(); 
                return true; 
            }
        }
        return false; 
    }

    public boolean registra(String username, String password) {
        for (User u : utentiRegistrati) {
            if (u.getUsername().equals(username)) {
                return false; 
            }
        }
        User nuovoUtente = new User(username, password);
        utentiRegistrati.add(nuovoUtente);
        salvaDati(); 
        return true; 
    }

    public void logout() {
        currentUser = null;
        salvaDati(); 
    }

    public void salvaDati() {
        try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream("uploop_database.dat"))) {
            oos.writeObject(utentiRegistrati);
            oos.writeObject(currentUser);
        } catch (Exception e) {
            System.out.println("Errore salvataggio: " + e.getMessage());
        }
    }

    @SuppressWarnings("unchecked")
    private void caricaDati() {
        try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream("uploop_database.dat"))) {
            utentiRegistrati = (List<User>) ois.readObject();
            currentUser = (User) ois.readObject();
        } catch (Exception e) {
            // Crea un admin usando solo username e password
            utentiRegistrati.add(new User("admin", "1234"));
        }
    }
}
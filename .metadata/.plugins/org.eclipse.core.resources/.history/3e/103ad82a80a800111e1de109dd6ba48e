package it.unipv.ingsfw.Uploop.view;

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.awt.image.BufferedImage;
import javax.imageio.ImageIO;
import java.io.File;

public class RegistrationFrame extends JFrame {

    private JTextField txtUsername;
    private JTextField txtEmail;
    private JPasswordField txtPassword;
    private JPasswordField txtConfermaPassword;
    
    private Color themeBlue = new Color(20, 0, 180); 

    public RegistrationFrame() {
        setTitle("Uploop - Registrazione");
        setSize(700, 800); 
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        BufferedImage logoImage = null;
        try {
            File f = new File("src/PHOTO-2026-02-14-14-19-50 2.jpg");
            if (!f.exists()) f = new File("PHOTO-2026-02-14-14-19-50 2.jpg");
            if (!f.exists()) f = new File("src/PHOTO-2026-02-14-14-19-50_2.jpg"); 

            if(f.exists()) {
                logoImage = ImageIO.read(f);
            }
        } catch(Exception e) { }

        JPanel mainPanel = new JPanel();
        mainPanel.setBackground(Color.WHITE); 
        mainPanel.setLayout(new BoxLayout(mainPanel, BoxLayout.Y_AXIS));
        mainPanel.setBorder(new EmptyBorder(20, 0, 30, 0));
        setContentPane(mainPanel);

        JLabel lblLogo = new JLabel();
        if (logoImage != null) {
            Image scaledLogo = logoImage.getScaledInstance(200, 200, Image.SCALE_SMOOTH);
            lblLogo.setIcon(new ImageIcon(scaledLogo));
        } else {
            lblLogo.setText("UPLOOP");
            lblLogo.setFont(new Font("Segoe UI", Font.BOLD, 40));
            lblLogo.setForeground(themeBlue);
        }
        lblLogo.setAlignmentX(Component.CENTER_ALIGNMENT);
        mainPanel.add(lblLogo);
        mainPanel.add(Box.createRigidArea(new Dimension(0, 10)));

        JPanel formWrapper = new JPanel(new FlowLayout(FlowLayout.CENTER));
        formWrapper.setOpaque(false);
        
        JPanel formPanel = new JPanel(new GridBagLayout());
        formPanel.setOpaque(false);
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.gridx = 0;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.anchor = GridBagConstraints.WEST;

        Font labelFont = new Font("Segoe UI", Font.BOLD, 15);
        Font inputFont = new Font("Segoe UI", Font.PLAIN, 15);
        Dimension inputSize = new Dimension(350, 45);

        gbc.gridy = 0; gbc.insets = new Insets(5, 0, 5, 0);
        JLabel lblUser = new JLabel("Username");
        lblUser.setFont(labelFont); lblUser.setForeground(Color.BLACK); 
        formPanel.add(lblUser, gbc);
        
        gbc.gridy = 1; gbc.insets = new Insets(0, 0, 15, 0);
        txtUsername = new JTextField();
        impostaStileModerno(txtUsername, inputFont, inputSize);
        formPanel.add(txtUsername, gbc);

        gbc.gridy = 2; gbc.insets = new Insets(0, 0, 5, 0);
        JLabel lblEmail = new JLabel("Email");
        lblEmail.setFont(labelFont); lblEmail.setForeground(Color.BLACK);
        formPanel.add(lblEmail, gbc);
        
        gbc.gridy = 3; gbc.insets = new Insets(0, 0, 15, 0);
        txtEmail = new JTextField();
        impostaStileModerno(txtEmail, inputFont, inputSize);
        formPanel.add(txtEmail, gbc);

        gbc.gridy = 4; gbc.insets = new Insets(0, 0, 5, 0);
        JLabel lblPass = new JLabel("Password");
        lblPass.setFont(labelFont); lblPass.setForeground(Color.BLACK);
        formPanel.add(lblPass, gbc);
        
        gbc.gridy = 5; gbc.insets = new Insets(0, 0, 15, 0);
        txtPassword = new JPasswordField();
        impostaStileModerno(txtPassword, inputFont, inputSize);
        formPanel.add(txtPassword, gbc);

        gbc.gridy = 6; gbc.insets = new Insets(0, 0, 5, 0);
        JLabel lblConf = new JLabel("Conferma Password");
        lblConf.setFont(labelFont); lblConf.setForeground(Color.BLACK);
        formPanel.add(lblConf, gbc);
        
        gbc.gridy = 7; gbc.insets = new Insets(0, 0, 25, 0);
        txtConfermaPassword = new JPasswordField();
        impostaStileModerno(txtConfermaPassword, inputFont, inputSize);
        formPanel.add(txtConfermaPassword, gbc);

        formWrapper.add(formPanel);
        mainPanel.add(formWrapper);
        
        ThemeButton btnRegistrati = new ThemeButton("COMPLETA REGISTRAZIONE", themeBlue, Color.WHITE, true);
        btnRegistrati.addActionListener(e -> eseguiRegistrazione());
        mainPanel.add(btnRegistrati);
        mainPanel.add(Box.createRigidArea(new Dimension(0, 15)));
        
        ThemeButton btnAccedi = new ThemeButton("HAI GIA' UN ACCOUNT? ACCEDI", Color.WHITE, themeBlue, false);
        btnAccedi.addActionListener(e -> {
            new LoginFrame(); 
            dispose();
        });
        mainPanel.add(btnAccedi);

        setVisible(true);
    }

    private void impostaStileModerno(JComponent campo, Font font, Dimension size) {
        campo.setFont(font); campo.setBackground(Color.WHITE); campo.setForeground(Color.BLACK); 
        campo.setOpaque(true); campo.setPreferredSize(size); campo.setMinimumSize(size);
        campo.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(new Color(200, 200, 200), 2),
            BorderFactory.createEmptyBorder(6, 12, 6, 12)
        ));
    }

    // --- LOGICA DI REGISTRAZIONE MVC ---
    private void eseguiRegistrazione() {
        String user = txtUsername.getText().trim();
        String email = txtEmail.getText().trim();
        String pass = new String(txtPassword.getPassword()).trim();
        String confPass = new String(txtConfermaPassword.getPassword()).trim();

        // 🚨 CHIAMATA AL CONTROLLER MVC: La View (questa classe) delega l'azione!
        RegistrationController controller = new RegistrationController();
        controller.gestisciRegistrazione(user, email, pass, confPass, this);
    }

    private class ThemeButton extends JButton {
        private Color bgColor; private Color fgColor; private boolean isFilled; 
        public ThemeButton(String text, Color bgColor, Color fgColor, boolean isFilled) {
            super(text); this.bgColor = bgColor; this.fgColor = fgColor; this.isFilled = isFilled;
            setForeground(fgColor); setFont(new Font("Segoe UI", Font.BOLD, 15));
            setContentAreaFilled(false); setFocusPainted(false); setBorderPainted(false);
            setCursor(new Cursor(Cursor.HAND_CURSOR)); setAlignmentX(Component.CENTER_ALIGNMENT);
            setPreferredSize(new Dimension(350, 50)); setMaximumSize(new Dimension(350, 50));
            addMouseListener(new java.awt.event.MouseAdapter() {
                public void mouseEntered(java.awt.event.MouseEvent evt) { setForeground(bgColor); }
                public void mouseExited(java.awt.event.MouseEvent evt) { setForeground(fgColor); }
            });
        }
        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create(); g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            if (getModel().isRollover()) {
                g2.setColor(fgColor); g2.fillRoundRect(0, 0, getWidth(), getHeight(), 10, 10);
            } else {
                if (isFilled) {
                    g2.setColor(bgColor); g2.fillRoundRect(0, 0, getWidth(), getHeight(), 10, 10);
                } else {
                    g2.setColor(bgColor); g2.fillRoundRect(0, 0, getWidth(), getHeight(), 10, 10);
                    g2.setColor(fgColor); g2.setStroke(new BasicStroke(2)); g2.drawRoundRect(1, 1, getWidth()-3, getHeight()-3, 10, 10);
                }
            }
            super.paintComponent(g); g2.dispose();
        }
    }
}